# Supply-chain hardening, see readme.md.
# Never run install scripts (preinstall, install, postinstall) of dependencies.
# Worms like Shai-Hulud spread through them. `npm run <script>` still works.
ignore-scripts=true
# Only install versions published at least 7 days ago, so malicious releases are usually pulled first.
min-release-age=7
# Only install from the npm registry, never from git repositories.
allow-git=none
# Refuse to run with an npm older than "engines" in package.json (11.10, the first with min-release-age).
engine-strict=true
