CORRESPONDANCE_EMAIL_ADDRESS=info@example.org
# Sender address, on one of the tenant's domains. Doesn't need a mailbox.
SERVER_EMAIL_ADDRESS=noreply@example.org
# Microsoft 365 connector relay: the tenant's MX host. Required unless DEV=1.
# SMTP_HOST=example-org.mail.protection.outlook.com
# SMTP_PORT=25
# Required unless DEV=1, so captcha challenges survive restarts: openssl rand -hex 32
# ALTCHA_HMAC_KEY=
# DEV=1 logs mails instead of sending them and proxies non-/api paths to DEV_PROXY
DEV=1
# DEV_PROXY=http://localhost:1313
